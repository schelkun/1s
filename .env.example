# 1s configuration: copy to .env, edit, then run scripts/macos/push-config.sh.
# Generated from config/schema.conf by scripts/dev/generate-reference.sh.
#
# * .env is git-ignored and stays on your Mac; push-config.sh stores it on the
#   server as root-only files.
# * Secrets (passwords, keys) are generated on the server when left empty, so
#   you normally set none. Read one with:
#   scripts/macos/server.sh config secret GITEA_ADMIN_PASSWORD
# * Commented-out lines show the default.
# * Example addresses are documentation ranges (RFC 5737); use your own.

# ==== Your Mac (used by scripts/macos only) ====

# Your administrative SSH login, e.g. root@203.0.113.5 or ubuntu@203.0.113.5 (needs sudo).
# Required.
SERVER_SSH=root@203.0.113.5

# SSH port of the server.
#SERVER_SSH_PORT=22

# GitHub repository as owner/name (only used to print links).
GITHUB_REPO=your-org/1s

# Deployment access auto-expires after this long (safety net if disable is never run).
#DEPLOY_ACCESS_TTL=2h

# ==== Shared infrastructure (Nginx, TLS, firewall, backups) ====

# Install/deploy Gitea (with deploy target "all").
#ENABLE_GITEA=true

# Install/deploy OpenHands (with deploy target "all").
#ENABLE_OPENHANDS=true

# Contact e-mail for the ACME (Let's Encrypt) account.
# Required.
ACME_EMAIL=admin@example.com

# acme.sh CA name or directory URL. Use letsencrypt_test for staging.
#ACME_SERVER=letsencrypt

# Certificate key type passed to acme.sh --keylength.
#ACME_KEY_TYPE=ec-256

# Optional acme.sh DNS API hook (e.g. dns_cf). Empty = HTTP-01 webroot validation.
#ACME_DNS_PROVIDER=

# Whitespace-separated KEY=VALUE pairs for the DNS hook (e.g. "CF_Token=... CF_Zone_ID=...").
# Secret: generated on the server when empty.
#ACME_DNS_CREDENTIALS=

# Skip the DNS-points-to-bind-IP check before HTTP-01 issuance (needed behind 1:1 NAT where the bind IP is private).
#ACME_SKIP_DNS_CHECK=false

# Warn in health checks when a certificate expires in fewer days than this.
#ACME_RENEW_DAYS=30

# Listen on the *_BIND_IP6 addresses as well.
#ENABLE_IPV6=false

# Comma-separated CIDRs of trusted L7 proxies/CDNs in front of Nginx. Empty = trust nobody; the TCP peer address is the client IP.
#TRUSTED_PROXIES=

# Strict-Transport-Security max-age in seconds (0 disables the header).
#HSTS_MAX_AGE=31536000

# Pinned Nginx image.
#NGINX_IMAGE=nginx:1.30.6-alpine

# Pinned small image used for volume backup/restore helpers.
#HELPER_IMAGE=alpine:3.22

# Local backup directory on the server.
#BACKUP_DIR=/var/backups/1s

# ==== Gitea, PostgreSQL and runners ====

# Public HTTPS domain for Gitea.
# Required when gitea is enabled.
GITEA_DOMAIN=git.example.com

# Public IPv4 address Nginx binds for Gitea.
# Required when gitea is enabled.
GITEA_BIND_IP=203.0.113.10

# Public IPv6 address for Gitea (used when ENABLE_IPV6=true).
#GITEA_BIND_IP6=

# Host name shown in SSH clone URLs.
#GITEA_SSH_DOMAIN=${GITEA_DOMAIN}

# IPv4 address for Git-over-SSH.
#GITEA_SSH_BIND_IP=${GITEA_BIND_IP}

# IPv6 address for Git-over-SSH (used when ENABLE_IPV6=true).
#GITEA_SSH_BIND_IP6=

# Public Git-over-SSH port. Must not collide with the host sshd.
#GITEA_SSH_PORT=2222

# Pinned Gitea image (rootless variant).
#GITEA_IMAGE=gitea/gitea:28.3.0-rootless

# Pinned PostgreSQL image.
#GITEA_POSTGRES_IMAGE=postgres:18.7-alpine

# Loopback port Gitea HTTP is published on (127.0.0.1 only).
#GITEA_LOCAL_PORT=13000

# Site title.
#GITEA_APP_NAME=Gitea

# Initial administrator login ("admin" is reserved by Gitea).
#GITEA_ADMIN_USER=gitea-admin

# Initial administrator e-mail.
# Required when gitea is enabled.
GITEA_ADMIN_EMAIL=admin@example.com

# Disable self-registration.
#GITEA_DISABLE_REGISTRATION=true

# Require sign-in to view anything.
#GITEA_REQUIRE_SIGNIN_VIEW=true

# Nginx client_max_body_size for Gitea (pushes, LFS, uploads).
#GITEA_MAX_BODY_SIZE=512m

# CPU limit for the Gitea container.
#GITEA_CPUS=2

# Memory limit for the Gitea container.
#GITEA_MEMORY=2g

# Memory limit for PostgreSQL.
#GITEA_DB_MEMORY=1g

# Private subnet of the Gitea compose network.
#GITEA_NETWORK_SUBNET=10.202.0.0/24

# Number of runner containers (0 disables runners).
#GITEA_RUNNER_COUNT=1

# Concurrent jobs per runner.
#GITEA_RUNNER_CAPACITY=1

# CPU limit per runner (shared by its jobs).
#GITEA_RUNNER_CPUS=2

# Memory limit per runner (shared by its jobs).
#GITEA_RUNNER_MEMORY=4g

# PID limit per runner.
#GITEA_RUNNER_PIDS_LIMIT=4096

# Comma-separated runner labels (label:docker://image).
#GITEA_RUNNER_LABELS=ubuntu-latest:docker://docker.gitea.com/runner-images:ubuntu-latest,ubuntu-24.04:docker://docker.gitea.com/runner-images:ubuntu-24.04

# Pinned runner image (must match GITEA_RUNNER_ISOLATION).
#GITEA_RUNNER_IMAGE=gitea/runner:6.0.0-dind-rootless

# rootless = rootless Docker-in-Docker without --privileged; privileged = rootful DinD (weaker).
#GITEA_RUNNER_ISOLATION=rootless

# AppArmor profile for rootless runners (installed by bootstrap; allows user namespaces on Ubuntu 24.04). Use unconfined only on hosts without AppArmor.
#GITEA_RUNNER_APPARMOR_PROFILE=1s-rootless-dind

# Optional path ON THE SERVER to a PEM CA bundle runners trust for Gitea (private CA setups). Empty = public CAs only.
#GITEA_RUNNER_CA_FILE=

# Expose the runner's own isolated Docker daemon to jobs (docker build in CI). Never the host daemon.
#GITEA_RUNNER_JOB_DOCKER=true

# Block CI job traffic to private, link-local and metadata addresses and to host services other than Gitea HTTPS.
#GITEA_RUNNER_BLOCK_PRIVATE_EGRESS=true

# /16 pool; runner N gets <pool>.N.0/24.
#GITEA_RUNNER_SUBNET_POOL=10.203.0.0/16

# Grace period for running jobs during runner updates.
#GITEA_RUNNER_SHUTDOWN_TIMEOUT=30m

# Maximum job duration.
#GITEA_RUNNER_JOB_TIMEOUT=3h

# Prune unused images/containers inside each runner's private daemon older than this.
#GITEA_RUNNER_PRUNE_AFTER=72h

# systemd OnCalendar expression for scheduled backups.
#GITEA_BACKUP_SCHEDULE=*-*-* 03:00:00

# Delete backups older than this many days.
#GITEA_BACKUP_RETENTION_DAYS=14

# Always keep at least this many backups.
#GITEA_BACKUP_KEEP_MIN=3

# Take a backup before every deployment/update.
#GITEA_BACKUP_BEFORE_DEPLOY=true

# Stop Gitea while archiving repositories (fully consistent, short downtime).
#GITEA_BACKUP_STOP_SERVICE=false

# Initial administrator password (only used when the admin does not exist yet).
# Secret: generated on the server when empty.
#GITEA_ADMIN_PASSWORD=

# PostgreSQL password (rotation is applied on deploy).
# Secret: generated on the server when empty.
#GITEA_DB_PASSWORD=

# Gitea [security] SECRET_KEY. Never rotate casually: it encrypts stored secrets.
# Secret: generated on the server when empty.
#GITEA_SECRET_KEY=

# Gitea [security] INTERNAL_TOKEN.
# Secret: generated on the server when empty.
#GITEA_INTERNAL_TOKEN=

# Gitea [oauth2] JWT_SECRET (base64url, 32 bytes).
# Secret: generated on the server when empty.
#GITEA_OAUTH2_JWT_SECRET=

# Gitea [server] LFS_JWT_SECRET (base64url, 32 bytes).
# Secret: generated on the server when empty.
#GITEA_LFS_JWT_SECRET=

# ==== OpenHands Agent Canvas ====

# Public HTTPS domain for OpenHands Agent Canvas.
# Required when openhands is enabled.
OPENHANDS_DOMAIN=ai.example.com

# Public IPv4 address Nginx binds for OpenHands.
# Required when openhands is enabled.
OPENHANDS_BIND_IP=203.0.113.20

# Public IPv6 address for OpenHands (used when ENABLE_IPV6=true).
#OPENHANDS_BIND_IP6=

# Comma-separated name:port pairs; each user gets an isolated instance on https://OPENHANDS_DOMAIN:port.
# Required when openhands is enabled.
OPENHANDS_USERS=alice:443,bob:8444

# Pinned Agent Canvas image.
#OPENHANDS_IMAGE=ghcr.io/openhands/agent-canvas:1.33.0

# Loopback port base; user #N is published on 127.0.0.1:(base+N).
#OPENHANDS_LOCAL_PORT_BASE=28000

# CPU limit per user instance.
#OPENHANDS_CPUS=2

# Memory limit per user instance.
#OPENHANDS_MEMORY=4g

# PID limit per user instance.
#OPENHANDS_PIDS_LIMIT=2048

# /16 pool; user #N gets <pool>.N.0/24.
#OPENHANDS_SUBNET_POOL=10.204.0.0/16

# Allow the agent to use sudo inside its container (disables no-new-privileges and restores default capabilities). Keep false unless agents must apt-get install.
#OPENHANDS_AGENT_SUDO=false

# Block agent traffic to private, link-local and metadata addresses and to host services.
#OPENHANDS_BLOCK_PRIVATE_EGRESS=true

# Allow agent instances to reach Gitea over HTTPS and Git-over-SSH (adds the OpenHands pool to the Gitea allowlists).
#OPENHANDS_ALLOW_GITEA=false

# Nginx client_max_body_size for OpenHands uploads.
#OPENHANDS_MAX_BODY_SIZE=100m

# systemd OnCalendar expression for scheduled backups.
#OPENHANDS_BACKUP_SCHEDULE=*-*-* 03:30:00

# Delete backups older than this many days.
#OPENHANDS_BACKUP_RETENTION_DAYS=14

# Always keep at least this many backups.
#OPENHANDS_BACKUP_KEEP_MIN=3

# Take a backup before every deployment/update.
#OPENHANDS_BACKUP_BEFORE_DEPLOY=true

# Stop each instance while archiving (its SQLite data must be consistent).
#OPENHANDS_BACKUP_STOP_SERVICE=true

# Master key from which each user's Agent Canvas API key is derived (HMAC). Safe to rotate.
# Secret: generated on the server when empty.
#OPENHANDS_API_MASTER_KEY=

# Master key from which each user's OH_SECRET_KEY is derived. Rotating makes stored agent secrets unreadable.
# Secret: generated on the server when empty.
#OPENHANDS_STORAGE_MASTER_KEY=
